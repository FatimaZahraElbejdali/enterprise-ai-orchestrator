# Odoo configuration
ODOO_URL=https://your-odoo-instance.odoo.com
ODOO_DB=your_database_name
ODOO_USERNAME=your_email@example.com
ODOO_PASSWORD=your_password_or_api_key
ODOO_API_KEY=your_api_key

# AI model keys
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
OPENAI_DEFAULT_MODEL=gpt-4.1-mini
OPENAI_CLASSIFIER_MODEL=gpt-4.1-mini
OPENAI_SUPPORT_MODEL=gpt-4.1-mini
OPENAI_KNOWLEDGE_MODEL=gpt-4.1-mini
OPENAI_SERVER_MODEL=gpt-4.1-mini
OPENAI_ODOO_ASSIST_MODEL=gpt-4.1-mini
OPENAI_DEVELOPMENT_MODEL=gpt-4.1
OPENAI_SECURITY_MODEL=gpt-4.1
ANTHROPIC_API_KEY=your_anthropic_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
